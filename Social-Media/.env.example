# ==============================================================================
# Pulse Social Media Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root and/or backend directory for local setup.
# Never commit the actual .env file or real secrets to GitHub.
# ==============================================================================

# General / Node.js Server Configuration
PORT=8000
NODE_ENV=development
JWT_SECRET=pulse-development-jwt-secret-key-replace-in-production

# Django Backend Configuration
SECRET_KEY=django-insecure-development-key-replace-in-production-random-alpha-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (Leave empty for local SQLite development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS & CSRF Configuration (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Security Settings (Set to True in HTTPS Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
